# Bootstrap and public endpoint
OPENMMP_REPOSITORY_ROOT=.
OPENMMP_RUNTIME_SECRET_ROOT=.openmmp
OPENMMP_PUBLIC_BASE_URL=http://localhost:8080

# Generated credentials. Run `npm run bootstrap`; do not commit real values.
OPENMMP_POSTGRES_BOOTSTRAP_PASSWORD=replace-with-a-random-local-secret
OPENMMP_APP_DATABASE_PASSWORD=replace-with-a-random-local-secret
OPENMMP_READER_DATABASE_PASSWORD=replace-with-a-random-local-secret
OPENMMP_SEED_DATABASE_PASSWORD=replace-with-a-random-local-secret
OPENMMP_ADMIN_KEY=replace-with-a-random-32-byte-key
OPENMMP_ADMIN_ROLE=admin
OPENMMP_MAX_PATH_SECRET=replace-with-a-random-path-secret
OPENMMP_MAX_EVENT_KEY=replace-with-a-random-event-key
OPENMMP_ADMIN_KEY_FILE=
OPENMMP_ADMIN_KEY_PREVIOUS=
OPENMMP_ADMIN_KEY_PREVIOUS_ROLE=admin
OPENMMP_ADMIN_KEY_PREVIOUS_FILE=
OPENMMP_MAX_PATH_SECRET_FILE=
OPENMMP_MAX_EVENT_KEY_FILE=
OPENMMP_PAYLOAD_MASTER_KEY=replace-with-a-random-32-byte-key
OPENMMP_PAYLOAD_MASTER_KEY_FILE=
OPENMMP_SDK_KEY_ID=sdk-key-current
OPENMMP_SDK_KEY=replace-with-a-random-32-byte-key
OPENMMP_SDK_KEY_FILE=
OPENMMP_SDK_KEY_PREVIOUS=
OPENMMP_SDK_KEY_PREVIOUS_FILE=
OPENMMP_SDK_KEY_PREVIOUS_ID=sdk-key-previous
OPENMMP_INSTALLATION_DIGEST_KEY=replace-with-a-random-32-byte-key
OPENMMP_INSTALLATION_DIGEST_KEY_FILE=
OPENMMP_META_IR_DECRYPTION_KEY=replace-with-a-random-64-character-hex-key
OPENMMP_META_IR_DECRYPTION_KEY_FILE=
OPENMMP_META_IR_DECRYPTION_KEY_PREVIOUS=
OPENMMP_META_IR_DECRYPTION_KEY_PREVIOUS_FILE=

# Runtime connections
OPENMMP_MIGRATION_DATABASE_URL=postgresql://postgres:replace-with-a-random-local-secret@localhost:5432/openmmp
OPENMMP_APP_DATABASE_URL=postgresql://openmmp_app:replace-with-a-random-local-secret@localhost:5432/openmmp
OPENMMP_READER_DATABASE_URL=postgresql://openmmp_reader:replace-with-a-random-local-secret@localhost:5432/openmmp
OPENMMP_SEED_DATABASE_URL=postgresql://openmmp_seed:replace-with-a-random-local-secret@localhost:5432/openmmp
OPENMMP_DATABASE_HOST=postgres
OPENMMP_DATABASE_PORT=5432
OPENMMP_DATABASE_NAME=openmmp

# API and worker
OPENMMP_API_PORT=8080
OPENMMP_WORKER_POLL_MS=5000
OPENMMP_SYNTHETIC_MODE=0
OPENMMP_MAX_TENANT_ID=tenant-local
OPENMMP_MAX_APP_ID=app-local
OPENMMP_MAX_TOKEN_MODE=all_with_event_fallback
OPENMMP_MAX_PARAMETER_LIMIT=40
OPENMMP_MAX_QUERY_BYTES=8192
OPENMMP_MAX_RATE_RPS=200
OPENMMP_MAX_RATE_BURST=500
OPENMMP_ADMIN_RATE_RPS=10
OPENMMP_ADMIN_RATE_BURST=30
OPENMMP_DASHBOARD_ENABLED=true
OPENMMP_DASHBOARD_SESSION_TTL_SECONDS=43200
OPENMMP_DASHBOARD_LOGIN_RATE_RPM=5
OPENMMP_DASHBOARD_LOGIN_RATE_BURST=10
OPENMMP_REPORT_MAX_ROWS=1000
OPENMMP_REPORT_EXPORT_MAX_ROWS=200000
OPENMMP_APPLE_ACCEPT_DEVELOPMENT_POSTBACKS=0
OPENMMP_POSTBACK_MAX_BYTES=16384
OPENMMP_POSTBACK_RATE_RPS=20
OPENMMP_POSTBACK_RATE_BURST=100
OPENMMP_POSTBACK_APP_RATE_RPS=200
OPENMMP_POSTBACK_APP_RATE_BURST=1000
OPENMMP_POSTBACK_INVALID_LEDGER_QUOTA_PER_HOUR=100
OPENMMP_ADSERVICES_LOOKUP=on
OPENMMP_ADSERVICES_ENDPOINT=https://api-adservices.apple.com/api/v1/
OPENMMP_ADSERVICES_LOOKUP_RATE_RPS=10
OPENMMP_ADSERVICES_LOOKUP_RATE_BURST=50
OPENMMP_PAYLOAD_STORE_DIR=.openmmp/payloads
OPENMMP_SDK_TENANT_ID=tenant-local
OPENMMP_INGEST_SKEW_MS=300000
OPENMMP_NONCE_TTL_MS=900000
OPENMMP_INGEST_MAX_BYTES=262144
OPENMMP_INGEST_MAX_EVENTS=100
OPENMMP_ENROLL_RATE_RPS=50
OPENMMP_ENROLL_RATE_BURST=100
OPENMMP_INGEST_RATE_RPS=1
OPENMMP_INGEST_RATE_BURST=20
OPENMMP_INGEST_APP_RATE_RPS=500
OPENMMP_INGEST_APP_RATE_BURST=1000
OPENMMP_DEVICE_PRIVACY_RATE_RPM=1
OPENMMP_DEVICE_PRIVACY_RATE_BURST=3
OPENMMP_REDIRECTOR_PORT=8090
OPENMMP_REDIRECTOR_BASE_URL=http://localhost:8090
OPENMMP_REDIRECTOR_TENANT_ID=tenant-local
OPENMMP_REDIRECTOR_FALLBACK_URL=https://play.google.com/store
OPENMMP_REDIRECTOR_DESTINATION_ALLOWLIST=
OPENMMP_REDIRECTOR_GEO=off
OPENMMP_REDIRECTOR_RATE_RPS=20
OPENMMP_REDIRECTOR_RATE_BURST=50
OPENMMP_MAPPINGS_DIR=examples/mappings
OPENMMP_IMPORT_INBOX=examples/synthetic
OPENMMP_IMPORT_MAX_BYTES=4294967296
OPENMMP_IMPORT_MAX_ROWS=20000000
OPENMMP_IMPORT_MAX_ROW_BYTES=65536
OPENMMP_IMPORT_BATCH_ROWS=5000
OPENMMP_BENCHMARK_ROWS=100000

# M5 verification only. Keep disabled in ordinary runtime processes.
OPENMMP_M5_BACKUP_RESTORE=0
OPENMMP_M5_PG_TOOLS=native
OPENMMP_M5_LOAD_BASE_URL=http://127.0.0.1:8080
OPENMMP_M5_LOAD_EVENTS=100000
OPENMMP_M5_LOAD_MAX_POSTBACKS=10000
OPENMMP_M5_LOAD_CONCURRENCY=40
OPENMMP_M5_LOAD_OUTPUT=
OPENMMP_META_ACCESS_TOKEN=
OPENMMP_META_ACCESS_TOKEN_FILE=
OPENMMP_GOOGLE_ADS_ACCESS_TOKEN=
OPENMMP_GOOGLE_ADS_ACCESS_TOKEN_FILE=
OPENMMP_GOOGLE_ADS_DEVELOPER_TOKEN=
OPENMMP_GOOGLE_ADS_DEVELOPER_TOKEN_FILE=
OPENMMP_MAX_REPORT_KEY=
OPENMMP_MAX_REPORT_KEY_FILE=
