# Bootstrap and public endpoint
OPENMASU_REPOSITORY_ROOT=.
OPENMASU_RUNTIME_SECRET_ROOT=.openmasu
OPENMASU_PUBLIC_BASE_URL=http://localhost:8080

# Generated credentials. Run `npm run bootstrap`; do not commit real values.
OPENMASU_POSTGRES_BOOTSTRAP_PASSWORD=replace-with-a-random-local-secret
OPENMASU_APP_DATABASE_PASSWORD=replace-with-a-random-local-secret
OPENMASU_READER_DATABASE_PASSWORD=replace-with-a-random-local-secret
OPENMASU_SEED_DATABASE_PASSWORD=replace-with-a-random-local-secret
OPENMASU_ADMIN_KEY=replace-with-a-random-32-byte-key
OPENMASU_ADMIN_ROLE=admin
OPENMASU_MAX_PATH_SECRET=replace-with-a-random-path-secret
OPENMASU_MAX_EVENT_KEY=replace-with-a-random-event-key
OPENMASU_ADMIN_KEY_FILE=
OPENMASU_ADMIN_KEY_PREVIOUS=
OPENMASU_ADMIN_KEY_PREVIOUS_ROLE=admin
OPENMASU_ADMIN_KEY_PREVIOUS_FILE=
OPENMASU_MAX_PATH_SECRET_FILE=
OPENMASU_MAX_EVENT_KEY_FILE=
OPENMASU_PAYLOAD_MASTER_KEY=replace-with-a-random-32-byte-key
OPENMASU_PAYLOAD_MASTER_KEY_FILE=
OPENMASU_SDK_KEY_ID=sdk-key-current
OPENMASU_SDK_KEY=replace-with-a-random-32-byte-key
OPENMASU_SDK_KEY_FILE=
OPENMASU_SDK_KEY_PREVIOUS=
OPENMASU_SDK_KEY_PREVIOUS_FILE=
OPENMASU_SDK_KEY_PREVIOUS_ID=sdk-key-previous
OPENMASU_INSTALLATION_DIGEST_KEY=replace-with-a-random-32-byte-key
OPENMASU_INSTALLATION_DIGEST_KEY_FILE=
OPENMASU_META_IR_DECRYPTION_KEY=replace-with-a-random-64-character-hex-key
OPENMASU_META_IR_DECRYPTION_KEY_FILE=
OPENMASU_META_IR_DECRYPTION_KEY_PREVIOUS=
OPENMASU_META_IR_DECRYPTION_KEY_PREVIOUS_FILE=

# Runtime connections
OPENMASU_MIGRATION_DATABASE_URL=postgresql://postgres:replace-with-a-random-local-secret@localhost:5432/openmasu
OPENMASU_APP_DATABASE_URL=postgresql://openmasu_app:replace-with-a-random-local-secret@localhost:5432/openmasu
OPENMASU_READER_DATABASE_URL=postgresql://openmasu_reader:replace-with-a-random-local-secret@localhost:5432/openmasu
OPENMASU_SEED_DATABASE_URL=postgresql://openmasu_seed:replace-with-a-random-local-secret@localhost:5432/openmasu
OPENMASU_DATABASE_HOST=postgres
OPENMASU_DATABASE_PORT=5432
OPENMASU_DATABASE_NAME=openmasu

# API and worker
OPENMASU_API_PORT=8080
OPENMASU_WORKER_POLL_MS=5000
OPENMASU_SYNTHETIC_MODE=0
OPENMASU_MAX_TENANT_ID=tenant-local
OPENMASU_MAX_APP_ID=app-local
OPENMASU_MAX_TOKEN_MODE=all_with_event_fallback
OPENMASU_MAX_PARAMETER_LIMIT=40
OPENMASU_MAX_QUERY_BYTES=8192
OPENMASU_MAX_RATE_RPS=200
OPENMASU_MAX_RATE_BURST=500
OPENMASU_ADMIN_RATE_RPS=10
OPENMASU_ADMIN_RATE_BURST=30
OPENMASU_DASHBOARD_ENABLED=true
OPENMASU_DASHBOARD_SESSION_TTL_SECONDS=43200
OPENMASU_DASHBOARD_LOGIN_RATE_RPM=5
OPENMASU_DASHBOARD_LOGIN_RATE_BURST=10
OPENMASU_REPORT_MAX_ROWS=1000
OPENMASU_REPORT_EXPORT_MAX_ROWS=200000
OPENMASU_APPLE_ACCEPT_DEVELOPMENT_POSTBACKS=0
OPENMASU_POSTBACK_MAX_BYTES=16384
OPENMASU_POSTBACK_RATE_RPS=20
OPENMASU_POSTBACK_RATE_BURST=100
OPENMASU_POSTBACK_APP_RATE_RPS=200
OPENMASU_POSTBACK_APP_RATE_BURST=1000
OPENMASU_POSTBACK_INVALID_LEDGER_QUOTA_PER_HOUR=100
OPENMASU_ADSERVICES_LOOKUP=on
OPENMASU_ADSERVICES_ENDPOINT=https://api-adservices.apple.com/api/v1/
OPENMASU_ADSERVICES_LOOKUP_RATE_RPS=10
OPENMASU_ADSERVICES_LOOKUP_RATE_BURST=50
OPENMASU_PAYLOAD_STORE_DIR=.openmasu/payloads
OPENMASU_SDK_TENANT_ID=tenant-local
OPENMASU_INGEST_SKEW_MS=300000
OPENMASU_NONCE_TTL_MS=900000
OPENMASU_INGEST_MAX_BYTES=262144
OPENMASU_INGEST_MAX_EVENTS=100
OPENMASU_ENROLL_RATE_RPS=50
OPENMASU_ENROLL_RATE_BURST=100
OPENMASU_INGEST_RATE_RPS=1
OPENMASU_INGEST_RATE_BURST=20
OPENMASU_INGEST_APP_RATE_RPS=500
OPENMASU_INGEST_APP_RATE_BURST=1000
OPENMASU_DEVICE_PRIVACY_RATE_RPM=1
OPENMASU_DEVICE_PRIVACY_RATE_BURST=3
OPENMASU_REDIRECTOR_PORT=8090
OPENMASU_REDIRECTOR_BASE_URL=http://localhost:8090
OPENMASU_REDIRECTOR_TENANT_ID=tenant-local
OPENMASU_REDIRECTOR_FALLBACK_URL=https://play.google.com/store
OPENMASU_REDIRECTOR_DESTINATION_ALLOWLIST=
OPENMASU_REDIRECTOR_GEO=off
OPENMASU_REDIRECTOR_RATE_RPS=20
OPENMASU_REDIRECTOR_RATE_BURST=50
OPENMASU_MAPPINGS_DIR=examples/mappings
OPENMASU_IMPORT_INBOX=examples/synthetic
OPENMASU_IMPORT_MAX_BYTES=4294967296
OPENMASU_IMPORT_MAX_ROWS=20000000
OPENMASU_IMPORT_MAX_ROW_BYTES=65536
OPENMASU_IMPORT_BATCH_ROWS=5000
OPENMASU_BENCHMARK_ROWS=100000

# M5 verification only. Keep disabled in ordinary runtime processes.
OPENMASU_M5_BACKUP_RESTORE=0
OPENMASU_M5_PG_TOOLS=native
OPENMASU_M5_LOAD_BASE_URL=http://127.0.0.1:8080
OPENMASU_M5_LOAD_EVENTS=100000
OPENMASU_M5_LOAD_MAX_POSTBACKS=10000
OPENMASU_M5_LOAD_CONCURRENCY=40
OPENMASU_M5_LOAD_OUTPUT=
OPENMASU_META_ACCESS_TOKEN=
OPENMASU_META_ACCESS_TOKEN_FILE=
OPENMASU_GOOGLE_ADS_ACCESS_TOKEN=
OPENMASU_GOOGLE_ADS_ACCESS_TOKEN_FILE=
OPENMASU_GOOGLE_ADS_DEVELOPER_TOKEN=
OPENMASU_GOOGLE_ADS_DEVELOPER_TOKEN_FILE=
OPENMASU_MAX_REPORT_KEY=
OPENMASU_MAX_REPORT_KEY_FILE=
