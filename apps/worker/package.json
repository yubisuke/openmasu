{
  "name": "@openmasu/worker",
  "version": "0.1.0",
  "private": true,
  "description": "OpenMasu ingestion worker",
  "type": "module",
  "scripts": {
    "benchmark:metric-floor": "cd ../.. && node --env-file-if-exists=.env --import tsx apps/worker/src/metrics/benchmark.ts",
    "import": "cd ../.. && node --env-file-if-exists=.env --import tsx apps/worker/src/import/runner.ts",
    "import:cost": "cd ../.. && node --env-file-if-exists=.env --import tsx apps/worker/src/import/cost-cli.ts",
    "metrics:run": "cd ../.. && node --env-file-if-exists=.env --import tsx apps/worker/src/metrics/run.ts",
    "demo:metrics": "cd ../.. && node --env-file-if-exists=.env --import tsx apps/worker/src/demo-metrics.ts",
    "db:reapply-privacy": "cd ../.. && node --env-file-if-exists=.env --import tsx apps/worker/src/reapply-privacy.ts --",
    "seed": "cd ../.. && node --env-file-if-exists=.env --import tsx apps/worker/src/seed.ts",
    "verify:parity": "cd ../.. && node --env-file-if-exists=.env --import tsx apps/worker/src/verify-parity.ts"
  },
  "dependencies": {
    "@openmasu/attribution-core": "0.4.0",
    "@openmasu/contracts": "0.4.0",
    "@openmasu/meta-install-referrer": "0.1.0",
    "@openmasu/runtime": "0.1.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  }
}
