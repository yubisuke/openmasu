{
  "name": "@openmasu/runtime",
  "version": "0.1.0",
  "private": true,
  "description": "OpenMasu PostgreSQL runtime and migration tooling",
  "type": "module",
  "exports": {
    "./cohort-comparison": "./src/cohort-comparison.ts",
    "./comparison-model": "./src/comparison-model.ts",
    "./external-calculation-declaration": "./src/external-calculation-declaration.ts",
    "./metric-freshness": "./src/metric-freshness.ts",
    "./report-query-model": "./src/report-query-model.ts",
    "./recurring-comparisons": "./src/recurring-comparisons.ts",
    "./backup": {
      "types": "./src/backup.ts",
      "default": "./src/backup.ts"
    },
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./import-normalization": {
      "types": "./src/import-normalization.ts",
      "default": "./src/import-normalization.ts"
    },
    "./privacy-fence": {
      "types": "./src/privacy-fence.ts",
      "default": "./src/privacy-fence.ts"
    },
    "./apple-purchase-binding": {
      "types": "./src/apple-purchase-binding.ts",
      "default": "./src/apple-purchase-binding.ts"
    },
    "./metric-comparison": {
      "types": "./src/metric-comparison.ts",
      "default": "./src/metric-comparison.ts"
    },
    "./report-snapshot": "./src/report-snapshot.ts",
    "./metric-series": "./src/metric-series.ts",
    "./metric-freshness-query": "./src/metric-freshness-query.ts",
    "./comparison-export": "./src/comparison-export.ts",
    "./fixed-comparison": "./src/fixed-comparison.ts",
    "./metric-report-query": "./src/metric-report-query.ts",
    "./metric-report-read": "./src/metric-report-read.ts",
    "./acquisition-kpi-key": "./src/acquisition-kpi-key.ts",
    "./operator-webhook-signing": "./src/operator-webhook-signing.ts"
  },
  "scripts": {
    "db:migrate": "cd ../.. && node --env-file-if-exists=.env --import tsx apps/runtime/src/migrate.ts",
    "db:schema:dump": "cd ../.. && node --env-file-if-exists=.env --import tsx apps/runtime/src/schema-snapshot.ts --write",
    "db:schema:check": "cd ../.. && node --env-file-if-exists=.env --import tsx apps/runtime/src/schema-snapshot.ts --check",
    "test:db-invariants": "cd ../.. && node --env-file-if-exists=.env --import tsx apps/runtime/src/db-invariants.test.ts && node --env-file-if-exists=.env --import tsx apps/runtime/src/role-grants.db.test.ts"
  },
  "dependencies": {
    "@openmasu/attribution-core": "0.4.0",
    "@openmasu/contracts": "0.4.0",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/pg": "8.23.1"
  }
}
