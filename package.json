{
  "name": "openmasu-contract",
  "version": "0.4.0",
  "private": true,
  "description": "OpenMasu Event & Metric Contract v0.4.0 reference validation",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "22.18.0",
    "npm": "11.6.2"
  },
  "scripts": {
    "benchmark:metric-floor": "npm run benchmark:metric-floor --workspace @openmasu/worker",
    "benchmark:m5": "node --import tsx tools/m5-load.ts",
    "bootstrap": "node --import tsx apps/runtime/src/bootstrap.ts",
    "db:migrate": "npm run db:migrate --workspace @openmasu/runtime",
    "db:reapply-privacy": "npm run db:reapply-privacy --workspace @openmasu/worker --",
    "db:schema:dump": "npm run db:schema:dump --workspace @openmasu/runtime",
    "db:schema:check": "npm run db:schema:check --workspace @openmasu/runtime",
    "demo:metrics": "npm run demo:metrics --workspace @openmasu/worker",
    "generate:types": "npm run generate:types --workspace @openmasu/contracts",
    "import": "npm run import --workspace @openmasu/worker --",
    "import:cost": "npm run import:cost --workspace @openmasu/worker --",
    "metrics:run": "npm run metrics:run --workspace @openmasu/worker --",
    "seed": "npm run seed --workspace @openmasu/worker",
    "sbom": "node --import tsx tools/sbom.ts",
    "check:api-runtime-sbom": "node --import tsx tools/check-api-runtime-sbom.ts",
    "check:operational-logs": "node --import tsx tools/check-no-payload-logs.ts",
    "check:sdk-ios": "node tools/check-ios-sdk.mjs --source-only",
    "check:threat-model": "node --import tsx tools/check-threat-model.ts",
    "test:db-invariants": "npm run test:db-invariants --workspace @openmasu/runtime",
    "test:backup-restore": "node --env-file-if-exists=.env --import tsx --test --test-concurrency=1 apps/worker/src/privacy-reapply.integration.test.ts",
    "test:dashboard-parity": "node --env-file-if-exists=.env --import tsx --test apps/api/src/consistency.integration.test.ts",
    "test:env-coverage": "node --import tsx apps/runtime/src/env-coverage.test.ts",
    "test": "node --import tsx --test \"apps/**/*.unit.test.ts\" \"packages/**/*.unit.test.ts\"",
    "test:integration": "node --env-file-if-exists=.env --import tsx --test --test-concurrency=1 \"apps/**/*.integration.test.ts\"",
    "test:m2a": "node --env-file-if-exists=.env --import tsx --test --test-concurrency=1 apps/api/src/sdk-auth.unit.test.ts apps/api/src/m2a.integration.test.ts apps/redirector/src/redirector.integration.test.ts packages/attribution-core/src/install-referrer-mapping.unit.test.ts packages/meta-install-referrer/src/meta-install-referrer.unit.test.ts packages/redirector-core/src/redirector-core.unit.test.ts",
    "test:metric-parity": "node --env-file-if-exists=.env --import tsx --test apps/worker/src/metric-parity.metric.test.ts",
    "test:privacy-e2e": "node --env-file-if-exists=.env --import tsx --test --test-concurrency=1 apps/api/src/m2a.integration.test.ts apps/worker/src/privacy-reapply.integration.test.ts",
    "smoke:runtime": "node --import tsx tools/runtime-smoke.ts",
    "validate": "npm run typecheck && npm run validate:test --workspace @openmasu/contracts && npm run validate:summary --workspace @openmasu/contracts",
    "verify:consistency": "npm run test:dashboard-parity",
    "verify:contract-rename": "node --import tsx tools/verify-contract-v0.4-rename.ts",
    "verify:parity": "npm run verify:parity --workspace @openmasu/worker",
    "typecheck": "npm run typecheck --workspace @openmasu/contracts"
  }
}
