{
  "name": "openmasu-contract",
  "version": "0.4.0",
  "private": true,
  "description": "OpenMasu Event & Metric Contract v0.4.0 reference validation",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "22.18.0",
    "npm": "11.6.2"
  },
  "scripts": {
    "benchmark:metric-floor": "npm run benchmark:metric-floor --workspace @openmasu/worker",
    "benchmark:import": "npm run benchmark:import --workspace @openmasu/worker",
    "benchmark:m5": "node --import tsx tools/m5-load.ts",
    "build:sdk-release": "python tools/build-sdk-release.py",
    "bootstrap": "node --import tsx apps/runtime/src/bootstrap.ts",
    "commerce:backfill": "npm run commerce:backfill --workspace @openmasu/worker --",
    "db:migrate": "npm run db:migrate --workspace @openmasu/runtime",
    "db:reapply-privacy": "npm run db:reapply-privacy --workspace @openmasu/worker --",
    "db:drain-privacy-purge": "npm run db:drain-privacy-purge --workspace @openmasu/worker --",
    "db:schema:dump": "npm run db:schema:dump --workspace @openmasu/runtime",
    "db:schema:check": "npm run db:schema:check --workspace @openmasu/runtime",
    "demo:metrics": "npm run demo:metrics --workspace @openmasu/worker",
    "generate:types": "npm run generate:types --workspace @openmasu/contracts",
    "import": "npm run import --workspace @openmasu/worker --",
    "import:preview": "npm run import:preview --workspace @openmasu/worker --",
    "import:compatibility": "npm run import:compatibility --workspace @openmasu/worker --",
    "import:cost": "npm run import:cost --workspace @openmasu/worker --",
    "import:cost:google": "npm run import:cost:google --workspace @openmasu/worker --",
    "import:cost:meta": "npm run import:cost:meta --workspace @openmasu/worker --",
    "import:revenue:max": "npm run import:revenue:max --workspace @openmasu/worker --",
    "import:revenue:compatibility": "npm run import:revenue:compatibility --workspace @openmasu/worker --",
    "test:financial-parity": "node --env-file-if-exists=.env --import tsx --test --test-concurrency=1 --test-name-pattern=\"manual-cost compatibility|provider-reported aggregate-revenue compatibility|WO11 carries|Issue 61\" apps/worker/src/import/import.unit.test.ts apps/worker/src/import/aggregate-revenue-compatibility.unit.test.ts apps/worker/src/import/runtime.integration.test.ts",
    "metrics:run": "npm run metrics:run --workspace @openmasu/worker --",
    "pilot:preflight": "node --import tsx tools/pilot-preflight.ts",
    "pilot:synthetic": "node --import tsx tools/synthetic-runtime-pilot.ts",
    "seed": "npm run seed --workspace @openmasu/worker",
    "sbom": "node --import tsx tools/sbom.ts",
    "check:api-runtime-sbom": "node --import tsx tools/check-api-runtime-sbom.ts",
    "check:doc-drift": "node --import tsx tools/check-doc-drift.ts",
    "check:doc-links": "node --import tsx tools/check-doc-links.ts",
    "check:operational-logs": "node --import tsx tools/check-no-payload-logs.ts",
    "check:release-version": "node --import tsx tools/check-release-version.ts",
    "check:sdk-ios": "node tools/check-ios-sdk.mjs --source-only",
    "check:sdk-release": "python tools/build-sdk-release.py --verify-only build/sdk-release/openmasu-sdk-0.2.0",
    "check:threat-model": "node --import tsx tools/check-threat-model.ts",
    "check:workflow-permissions": "node --import tsx tools/check-workflow-permissions.ts",
    "check:fraud-sources": "node --import tsx tools/check-fraud-sources.ts",
    "check:fraud-artifacts": "node --import tsx tools/check-fraud-artifacts.ts",
    "test:db-invariants": "npm run test:db-invariants --workspace @openmasu/runtime",
    "test:backup-restore": "node --env-file-if-exists=.env --import tsx --test --test-concurrency=1 apps/worker/src/privacy-reapply.integration.test.ts",
    "test:dashboard-parity": "node --env-file-if-exists=.env --import tsx --test apps/api/src/consistency.integration.test.ts",
    "test:env-coverage": "node --import tsx apps/runtime/src/env-coverage.test.ts",
    "test": "node --import tsx --test \"apps/**/*.unit.test.ts\" \"packages/**/*.unit.test.ts\" \"tools/**/*.unit.test.ts\"",
    "test:integration": "node --env-file-if-exists=.env --import tsx --test --test-concurrency=1 \"apps/**/*.integration.test.ts\"",
    "test:unity-upm": "python tools/verify-unity-upm.py",
    "test:m2a": "node --env-file-if-exists=.env --import tsx --test --test-concurrency=1 apps/api/src/sdk-auth.unit.test.ts apps/api/src/server-auth.unit.test.ts apps/api/src/server-events.integration.test.ts apps/api/src/m2a.integration.test.ts apps/worker/src/sdk-auxiliary-recovery.integration.test.ts apps/redirector/src/redirector.integration.test.ts packages/attribution-core/src/install-referrer-mapping.unit.test.ts packages/meta-install-referrer/src/meta-install-referrer.unit.test.ts packages/redirector-core/src/redirector-core.unit.test.ts",
    "test:metric-parity": "node --env-file-if-exists=.env --import tsx --test apps/worker/src/metric-parity.metric.test.ts",
    "test:privacy-e2e": "node --env-file-if-exists=.env --import tsx --test --test-concurrency=1 apps/api/src/m2a.integration.test.ts apps/worker/src/privacy-reapply.integration.test.ts",
    "test:sdk-release-tool": "python -m unittest tools/build_sdk_release_test.py",
    "smoke:runtime": "node --import tsx tools/runtime-smoke.ts",
    "probe:unity-android-export": "python tools/unity-android-export-probe.py",
    "validate": "npm run check:release-version && npm run test:sdk-release-tool && npm run check:doc-links && npm run check:doc-drift && npm run check:workflow-permissions && npm run check:threat-model && npm run typecheck && npm run validate:test --workspace @openmasu/contracts && npm run check:fraud-artifacts && npm run validate:summary --workspace @openmasu/contracts",
    "verify:consistency": "npm run test:dashboard-parity",
    "verify:contract-rename": "node --import tsx tools/verify-contract-v0.4-rename.ts",
    "verify:parity": "npm run verify:parity --workspace @openmasu/worker",
    "typecheck": "npm run typecheck --workspace @openmasu/contracts"
  }
}
