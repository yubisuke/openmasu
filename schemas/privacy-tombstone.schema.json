{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openmasu:schema:privacy-tombstone:v0.4",
  "title": "OpenMasu Privacy Tombstone v0.4",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "tenant_id", "app_id", "privacy_request_id", "record_id", "lifecycle_status", "reason_code", "policy_version", "provenance_digest", "created_at"],
  "properties": {
    "contract_version": { "const": "0.4.0" },
    "tenant_id": { "$ref": "common.schema.json#/$defs/id" },
    "app_id": { "$ref": "common.schema.json#/$defs/id" },
    "privacy_request_id": { "$ref": "common.schema.json#/$defs/id" },
    "record_id": { "$ref": "common.schema.json#/$defs/id" },
    "lifecycle_status": { "enum": ["redacted", "purged"] },
    "reason_code": { "enum": ["privacy_deletion", "retention_expiry"] },
    "policy_version": { "type": "string", "minLength": 1 },
    "provenance_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "created_at": { "$ref": "common.schema.json#/$defs/dateTime" }
  }
}
