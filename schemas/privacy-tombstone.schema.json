{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:open-mmp:schema:privacy-tombstone:v0.1",
  "title": "Open MMP Privacy Tombstone v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "tenant_id", "app_id", "privacy_request_id", "record_id", "lifecycle_status", "reason_digest", "policy_digest", "provenance_digest", "created_at"],
  "properties": {
    "contract_version": { "const": "0.1.0" },
    "tenant_id": { "$ref": "common.schema.json#/$defs/id" },
    "app_id": { "$ref": "common.schema.json#/$defs/id" },
    "privacy_request_id": { "$ref": "common.schema.json#/$defs/id" },
    "record_id": { "$ref": "common.schema.json#/$defs/id" },
    "lifecycle_status": { "enum": ["redacted", "purged"] },
    "reason_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "policy_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "provenance_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "created_at": { "$ref": "common.schema.json#/$defs/dateTime" }
  }
}
