{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:open-mmp:schema:common:v0.3",
  "title": "Open MMP Common Types v0.3",
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$" },
    "clickId": {
      "allOf": [
        { "$ref": "#/$defs/id" },
        { "type": "string", "pattern": "^[A-Za-z0-9_-]{22,128}$" }
      ]
    },
    "dateTime": { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" },
    "processingPurposeId": { "enum": ["attribution", "fraud_prevention", "analytics", "revenue_measurement"] },
    "money": {
      "type": "object",
      "additionalProperties": true,
      "required": ["amount_unscaled", "amount_scale", "currency"],
      "properties": {
        "amount_unscaled": { "type": "string", "pattern": "^[0-9]+$" },
        "amount_scale": { "type": "integer", "minimum": 0, "maximum": 18 },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }
      }
    },
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tenant_id", "app_id", "ref", "lifecycle_status", "access_class"],
      "properties": {
        "tenant_id": { "$ref": "#/$defs/id" },
        "app_id": { "$ref": "#/$defs/id" },
        "ref": { "type": "string" },
        "lifecycle_status": { "enum": ["available", "redacted", "purged"] },
        "access_class": { "enum": ["public", "protected", "private"] }
      }
    },
    "integrityVerdict": {
      "type": "object",
      "additionalProperties": false,
      "description": "Server-assigned platform-integrity evidence. It is evidence only and does not independently determine attribution, fraud, or metric eligibility.",
      "required": ["provider", "verdict", "evaluated_at", "policy_version"],
      "properties": {
        "provider": { "enum": ["play_integrity", "app_attest"] },
        "verdict": { "enum": ["verified", "failed", "unavailable"] },
        "evaluated_at": { "$ref": "#/$defs/dateTime" },
        "policy_version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "evidence_ref": { "type": "string", "pattern": "^protected:[A-Za-z0-9._:-]{1,256}$" }
      },
      "allOf": [
        {
          "if": { "properties": { "verdict": { "enum": ["verified", "failed"] } }, "required": ["verdict"] },
          "then": {
            "properties": { "evidence_ref": {} },
            "required": ["evidence_ref"]
          },
          "else": {
            "not": {
              "properties": { "evidence_ref": {} },
              "required": ["evidence_ref"]
            }
          }
        }
      ]
    },
    "aggregationTimeZone": { "enum": ["UTC", "Asia/Tokyo"] },
    "importContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "provider_attributed", "provider_attribution_strategy"],
      "properties": {
        "provider": { "type": "string", "pattern": "^[a-z0-9-]{1,64}$" },
        "provider_attributed": { "type": "boolean" },
        "provider_attribution_strategy": { "enum": ["click_through", "view_through", "modeled", "self_attributed_network", "organic", "unattributed"] },
        "provider_install_ref": { "type": "string", "minLength": 1, "maxLength": 256 },
        "provider_click_ref": { "type": "string", "minLength": 1, "maxLength": 256 },
        "provider_campaign_ref": { "type": "string", "minLength": 1, "maxLength": 256 },
        "provider_adgroup_ref": { "type": "string", "minLength": 1, "maxLength": 256 },
        "provider_creative_ref": { "type": "string", "minLength": 1, "maxLength": 256 },
        "provider_network": { "type": "string", "minLength": 1, "maxLength": 128 },
        "provider_site_ref": { "type": "string", "minLength": 1, "maxLength": 256 },
        "provider_country": { "type": "string", "pattern": "^[A-Z]{2}$" },
        "provider_confirmed_at": { "$ref": "#/$defs/dateTime" }
      },
      "allOf": [
        {
          "if": { "properties": { "provider_attributed": { "const": true } }, "required": ["provider_attributed"] },
          "then": { "properties": { "provider_attribution_strategy": { "enum": ["click_through", "view_through", "modeled", "self_attributed_network"] } } },
          "else": { "properties": { "provider_attribution_strategy": { "enum": ["organic", "unattributed"] } } }
        }
      ]
    }
  }
}
