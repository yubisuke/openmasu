{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openmasu:schema:logical-event:v0.4",
  "title": "OpenMasu Logical Event v0.4",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "logical_event_id", "record_id", "tenant_id", "app_id", "producer", "event_id", "event_name", "record_lifecycle", "timeliness"],
  "properties": {
    "contract_version": { "const": "0.4.0" },
    "logical_event_id": { "$ref": "common.schema.json#/$defs/id" },
    "record_id": { "$ref": "common.schema.json#/$defs/id" },
    "tenant_id": { "$ref": "common.schema.json#/$defs/id" },
    "app_id": { "$ref": "common.schema.json#/$defs/id" },
    "producer": { "type": "string" },
    "event_id": { "$ref": "common.schema.json#/$defs/id" },
    "event_name": { "enum": ["click", "install", "session_start", "ad_impression", "ad_view", "ad_revenue", "purchase", "refund", "consent_changed", "custom_event", "skan_postback", "adattributionkit_postback", "deep_link_open"] },
    "record_lifecycle": { "enum": ["active", "retracted"] },
    "timeliness": { "enum": ["on_time", "late"] }
  }
}
