{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openmasu:schema:correction:v0.4",
  "title": "OpenMasu Correction v0.4",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "tenant_id", "app_id", "correction_id", "corrects_record_id", "correction_type", "correction_reason", "effective_at"],
  "properties": {
    "contract_version": { "const": "0.4.0" },
    "tenant_id": { "$ref": "common.schema.json#/$defs/id" },
    "app_id": { "$ref": "common.schema.json#/$defs/id" },
    "correction_id": { "$ref": "common.schema.json#/$defs/id" },
    "corrects_record_id": { "$ref": "common.schema.json#/$defs/id" },
    "correction_type": { "enum": ["correction", "retraction", "redaction"] },
    "correction_reason": { "enum": ["refund", "privacy_deletion", "retention_expiry", "duplicate_source"] },
    "effective_at": { "$ref": "common.schema.json#/$defs/dateTime" }
  }
}
