{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:open-mmp:schema:event-adattributionkit-postback:v0.3",
  "title": "Open MMP AdAttributionKit Postback Event v0.3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_name", "jws_string", "signature_verified", "postback_identifier",
    "advertised_item_identifier", "conversion_type", "ad_network_identifier",
    "impression_type", "postback_sequence_index", "did_win"
  ],
  "properties": {
    "event_name": { "const": "adattributionkit_postback" },
    "jws_string": { "type": "string", "pattern": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$" },
    "signature_verified": { "type": "boolean" },
    "signing_key_environment": { "enum": ["production", "development"] },
    "conversion_value": { "type": "integer", "minimum": 0, "maximum": 63 },
    "coarse_conversion_value": { "enum": ["low", "medium", "high"] },
    "ad_interaction_type": { "enum": ["view", "click"] },
    "country_code": { "type": "string", "pattern": "^[A-Z]{2}$" },
    "advertised_item_identifier": { "type": "integer", "minimum": 0 },
    "conversion_type": { "enum": ["download", "redownload"] },
    "marketplace_identifier": { "type": "string", "minLength": 1, "maxLength": 253 },
    "ad_network_identifier": { "type": "string", "minLength": 1, "maxLength": 128 },
    "impression_type": { "const": "app-impression" },
    "postback_sequence_index": { "type": "integer", "minimum": 0, "maximum": 2 },
    "source_identifier": { "type": "string", "pattern": "^[0-9]{2,4}$" },
    "did_win": { "type": "boolean" },
    "postback_identifier": { "type": "string", "minLength": 1, "maxLength": 128 },
    "publisher_item_identifier": { "type": "integer", "minimum": 0 },
    "extensions": { "type": "object", "additionalProperties": true }
  }
}
