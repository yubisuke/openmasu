{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openmasu:schema:event-purchase:v0.4",
  "title": "OpenMasu Purchase Event v0.4",
  "type": "object",
  "additionalProperties": false,
  "allOf": [{ "$ref": "../common.schema.json#/$defs/money" }],
  "required": ["event_name", "transaction_id", "amount_unscaled", "amount_scale", "currency", "financial_status"],
  "properties": { "event_name": { "const": "purchase" }, "transaction_id": { "$ref": "../common.schema.json#/$defs/id" }, "original_transaction_id": { "$ref": "../common.schema.json#/$defs/id" }, "amount_unscaled": {}, "amount_scale": {}, "currency": {}, "financial_status": { "enum": ["settled", "pending", "reversed"] }, "extensions": { "type": "object", "additionalProperties": true } }
}
