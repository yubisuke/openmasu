{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openmasu:schema:event-consent-changed:v0.4",
  "title": "OpenMasu Consent Changed Event v0.4",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_name", "consent_state", "effective_at", "consent_policy_version"],
  "properties": {
    "event_name": { "const": "consent_changed" },
    "consent_state": { "enum": ["granted", "denied", "withdrawn", "not_required", "unknown"] },
    "effective_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" },
    "consent_policy_version": { "type": "string" },
    "processing_purpose_id": { "enum": ["attribution", "analytics", "revenue_measurement"] },
    "consent_revision": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "extensions": { "type": "object", "additionalProperties": true }
  },
  "dependentRequired": { "processing_purpose_id": ["consent_revision"] }
}
