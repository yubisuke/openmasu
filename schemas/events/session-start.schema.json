{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:open-mmp:schema:event-session-start:v0.2",
  "title": "Open MMP Session Start Event v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_name", "installation_id", "session_id"],
  "properties": { "event_name": { "const": "session_start" }, "installation_id": { "$ref": "../common.schema.json#/$defs/id" }, "session_id": { "$ref": "../common.schema.json#/$defs/id" }, "import_context": { "$ref": "../common.schema.json#/$defs/importContext" }, "extensions": { "type": "object", "propertyNames": { "not": { "pattern": "^(import($|_)|imported($|_)|provider($|_))" } }, "additionalProperties": true } }
}
