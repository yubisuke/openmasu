{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:open-mmp:schema:metric-run:v0.2",
  "title": "Open MMP Metric Run v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "metric_run_id", "metric_name", "metric_definition_version", "input_snapshot_id",
    "input_received_at_watermark", "input_ledger_position", "computed_at", "data_freshness",
    "aggregation_time_zone", "rule_bundle_id", "rule_bundle_version", "rule_bundle_hash",
    "rounding_mode", "reproducibility_status", "value_type", "evidence_refs"
  ],
  "properties": {
    "metric_run_id": { "$ref": "common.schema.json#/$defs/id" },
    "metric_name": { "type": "string", "pattern": "^[a-z][a-z0-9_]{2,127}$" },
    "metric_definition_version": { "type": "string", "minLength": 1, "maxLength": 64 },
    "input_snapshot_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "input_ledger_position": { "type": "string", "minLength": 1 },
    "input_received_at_watermark": { "$ref": "common.schema.json#/$defs/dateTime" },
    "computed_at": { "$ref": "common.schema.json#/$defs/dateTime" },
    "data_freshness": { "enum": ["complete", "late_excluded", "recalculated"] },
    "aggregation_time_zone": { "$ref": "common.schema.json#/$defs/aggregationTimeZone" },
    "rule_bundle_id": { "$ref": "common.schema.json#/$defs/id" },
    "rule_bundle_version": { "type": "string", "minLength": 1 },
    "rule_bundle_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "fx_rate_unscaled": { "type": "string", "pattern": "^[0-9]+$" },
    "fx_rate_scale": { "type": "integer", "minimum": 0, "maximum": 18 },
    "fx_rate_source": { "type": "string", "minLength": 1 },
    "fx_rate_as_of": { "$ref": "common.schema.json#/$defs/dateTime" },
    "fx_rate_snapshot_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "fx_policy_version": { "type": "string", "minLength": 1 },
    "rounding_mode": { "const": "half_even" },
    "reproducibility_status": { "enum": ["fully_reproducible", "redaction_affected", "retention_affected"] },
    "value_type": { "enum": ["money", "ratio", "count"] },
    "value_state": {
      "enum": ["present", "undefined"],
      "default": "present",
      "description": "Absence is semantically present for v0.2.0 compatibility."
    },
    "undefined_reason": { "enum": ["no_attributed_cost", "no_activity_events", "empty_cohort"] },
    "value_unscaled": { "type": "string", "pattern": "^-?[0-9]+$" },
    "amount_scale": { "type": "integer", "minimum": 0, "maximum": 18 },
    "ratio_scale": { "type": "integer", "minimum": 0, "maximum": 18 },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "grouping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimensions", "dimension_digest"],
      "properties": {
        "dimensions": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "campaign_id": { "$ref": "common.schema.json#/$defs/id" },
            "network": { "type": "string", "minLength": 1, "maxLength": 128 },
            "country": { "type": "string", "pattern": "^[A-Z]{2}$" },
            "cohort_date": { "type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
          }
        },
        "dimension_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "supersedes_metric_run_id": { "$ref": "common.schema.json#/$defs/id" },
    "evidence_refs": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/evidenceRef" } }
  },
  "allOf": [
    {
      "if": {
        "properties": { "value_state": { "const": "undefined" } },
        "required": ["value_state"]
      },
      "then": {
        "properties": { "undefined_reason": {} },
        "required": ["undefined_reason"],
        "not": {
          "properties": { "value_unscaled": {} },
          "required": ["value_unscaled"]
        }
      },
      "else": {
        "properties": { "value_unscaled": {} },
        "required": ["value_unscaled"],
        "not": {
          "properties": { "undefined_reason": {} },
          "required": ["undefined_reason"]
        }
      }
    },
    {
      "if": { "properties": { "value_type": { "const": "money" } }, "required": ["value_type"] },
      "then": {
        "if": {
          "properties": { "value_state": { "const": "undefined" } },
          "required": ["value_state"]
        },
        "else": {
          "properties": {
            "amount_scale": {}, "currency": {}, "fx_rate_unscaled": {}, "fx_rate_scale": {},
            "fx_rate_source": {}, "fx_rate_as_of": {}, "fx_rate_snapshot_id": {}, "fx_policy_version": {}
          },
          "required": [
            "amount_scale", "currency", "fx_rate_unscaled", "fx_rate_scale", "fx_rate_source",
            "fx_rate_as_of", "fx_rate_snapshot_id", "fx_policy_version"
          ]
        }
      },
      "else": {
        "not": {
          "anyOf": [
            { "properties": { "amount_scale": {} }, "required": ["amount_scale"] },
            { "properties": { "currency": {} }, "required": ["currency"] },
            { "properties": { "fx_rate_unscaled": {} }, "required": ["fx_rate_unscaled"] },
            { "properties": { "fx_rate_scale": {} }, "required": ["fx_rate_scale"] },
            { "properties": { "fx_rate_source": {} }, "required": ["fx_rate_source"] },
            { "properties": { "fx_rate_as_of": {} }, "required": ["fx_rate_as_of"] },
            { "properties": { "fx_rate_snapshot_id": {} }, "required": ["fx_rate_snapshot_id"] },
            { "properties": { "fx_policy_version": {} }, "required": ["fx_policy_version"] }
          ]
        }
      }
    },
    {
      "if": { "properties": { "value_type": { "const": "ratio" } }, "required": ["value_type"] },
      "then": { "properties": { "ratio_scale": {} }, "required": ["ratio_scale"] },
      "else": {
        "not": {
          "properties": { "ratio_scale": {} },
          "required": ["ratio_scale"]
        }
      }
    }
  ]
}
