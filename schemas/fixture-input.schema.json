{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openmasu:schema:fixture-input:v0.4",
  "title": "OpenMasu Contract Fixture Input v0.4",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "fx_policy", "metric_evaluations", "privacy_requests"],
  "properties": {
    "contract_version": { "const": "0.4.0" },
    "server_context": { "$ref": "#/$defs/serverContext" },
    "records": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/record" } },
    "batches": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["batch_id", "server_context", "records"],
        "properties": {
          "batch_id": { "$ref": "common.schema.json#/$defs/id" },
          "server_context": { "$ref": "#/$defs/serverContext" },
          "records": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/record" } }
        },
        "allOf": [
          {
            "if": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "server_context": {
                  "type": "object",
                  "additionalProperties": true,
                  "properties": { "audience": { "const": "child_directed" } },
                  "required": ["audience"]
                }
              },
              "required": ["server_context"]
            },
            "then": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "records": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": true,
                    "properties": { "payload": { "$ref": "#/$defs/advertisingIdentifierFreeValue" } }
                  }
                }
              }
            }
          }
        ]
      }
    },
    "fx_policy": { "$ref": "#/$defs/fxPolicy" },
    "cost_records": {
      "type": "array",
      "items": { "$ref": "urn:openmasu:schema:cost-record:v0.4" }
    },
    "source_day_aggregates": {
      "type": "array",
      "items": { "$ref": "#/$defs/sourceDayAggregate" }
    },
    "metric_definitions": {
      "type": "array",
      "items": { "$ref": "urn:openmasu:schema:metric-definition:v0.4" }
    },
    "metric_evaluations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["metric_run_id_prefix", "input_received_at_watermark", "computed_at", "data_freshness", "privacy_state"],
        "properties": {
          "metric_run_id_prefix": { "$ref": "common.schema.json#/$defs/id" },
          "input_received_at_watermark": { "$ref": "common.schema.json#/$defs/dateTime" },
          "computed_at": { "$ref": "common.schema.json#/$defs/dateTime" },
          "data_freshness": { "enum": ["complete", "late_excluded", "recalculated"] },
          "privacy_state": { "enum": ["before", "after"] },
          "supersedes_metric_run_id_prefix": { "$ref": "common.schema.json#/$defs/id" },
          "metric_names": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{2,127}$" }
          },
          "grouping": {
            "type": "object",
            "additionalProperties": false,
            "minProperties": 1,
            "properties": {
              "campaign_id": { "$ref": "common.schema.json#/$defs/id" },
              "network": { "type": "string", "minLength": 1, "maxLength": 128 },
              "country": { "type": "string", "pattern": "^[A-Z]{2}$" },
              "cohort_date": { "type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
              "metric_date": { "type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
              "attribution_status": { "enum": ["organic", "non_organic", "unattributed"] },
              "apple_conversion_bucket": { "type": "string", "pattern": "^(fine:([0-9]|[1-5][0-9]|6[0-3])|coarse:(low|medium|high))$" }
            }
          }
        }
      }
    },
    "reconciliation_inputs": {
      "type": "array",
      "items": { "$ref": "#/$defs/reconciliationInput" }
    },
    "privacy_requests": {
      "type": "array",
      "items": { "$ref": "urn:openmasu:schema:privacy-request:v0.4" }
    },
    "correction_inputs": {
      "type": "array",
      "items": { "$ref": "urn:openmasu:schema:correction:v0.4" }
    },
    "pre_ingestion_rejections": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/preIngestionRejection" }
    },
    "retention_expirations": {
      "type": "array",
      "items": { "$ref": "#/$defs/retentionExpiration" }
    }
  },
  "oneOf": [
    {
      "properties": { "server_context": {}, "records": {} },
      "required": ["server_context", "records"],
      "not": {
        "properties": { "batches": {} },
        "required": ["batches"]
      }
    },
    {
      "properties": { "batches": {} },
      "required": ["batches"],
      "not": {
        "anyOf": [
          { "properties": { "server_context": {} }, "required": ["server_context"] },
          { "properties": { "records": {} }, "required": ["records"] }
        ]
      }
    },
    {
      "properties": { "pre_ingestion_rejections": {} },
      "required": ["pre_ingestion_rejections"],
      "not": {
        "anyOf": [
          { "properties": { "server_context": {} }, "required": ["server_context"] },
          { "properties": { "records": {} }, "required": ["records"] },
          { "properties": { "batches": {} }, "required": ["batches"] }
        ]
      }
    }
  ],
  "allOf": [
    {
      "if": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "server_context": {
            "type": "object",
            "additionalProperties": true,
            "properties": { "audience": { "const": "child_directed" } },
            "required": ["audience"]
          }
        },
        "required": ["server_context"]
      },
      "then": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "records": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true,
              "properties": { "payload": { "$ref": "#/$defs/advertisingIdentifierFreeValue" } }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sourceDayAggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tenant_id", "app_id", "metric_date", "campaign_id", "network", "site_id", "clicks", "installs", "medianCvr", "ctitP50Ms", "ctitP95Ms", "input_snapshot_id", "computed_at"],
      "properties": {
        "tenant_id": { "$ref": "common.schema.json#/$defs/id" },
        "app_id": { "$ref": "common.schema.json#/$defs/id" },
        "metric_date": { "type": "string", "format": "date" },
        "campaign_id": { "$ref": "common.schema.json#/$defs/id" },
        "network": { "type": "string", "minLength": 1, "maxLength": 128 },
        "site_id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "clicks": { "type": "integer", "minimum": 0 },
        "installs": { "type": "integer", "minimum": 0 },
        "medianCvr": { "type": "number", "minimum": 0, "maximum": 1 },
        "ctitP50Ms": { "type": "integer", "minimum": 0 },
        "ctitP95Ms": { "type": "integer", "minimum": 0 },
        "ctitNegativeCount": { "type": "integer", "minimum": 0 },
        "input_snapshot_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "computed_at": { "$ref": "common.schema.json#/$defs/dateTime" }
      }
    },
    "serverContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tenant_id", "app_id", "received_at", "policy_digest", "processing_purposes", "withdrawals", "alternative_legal_bases"],
      "properties": {
        "tenant_id": { "$ref": "common.schema.json#/$defs/id" },
        "app_id": { "$ref": "common.schema.json#/$defs/id" },
        "audience": {
          "enum": ["general", "mixed", "child_directed"],
          "default": "general",
          "description": "Application audience classification. Absence is semantically general."
        },
        "received_at": { "$ref": "common.schema.json#/$defs/dateTime" },
        "policy_digest": { "type": "string", "minLength": 1 },
        "deep_link_resolution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": {
            "status": { "enum": ["active", "inactive", "unknown"] },
            "tracking_link_id": { "$ref": "common.schema.json#/$defs/id" },
            "campaign_id": { "$ref": "common.schema.json#/$defs/id" },
            "install_attribution_click_id": { "$ref": "common.schema.json#/$defs/clickId" }
          }
        },
        "processing_purposes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["processing_purpose_id", "consent_required", "policy_version"],
            "properties": {
              "processing_purpose_id": { "$ref": "common.schema.json#/$defs/processingPurposeId" },
              "consent_required": { "type": "boolean" },
              "policy_version": { "type": "string", "minLength": 1 }
            }
          }
        },
        "withdrawals": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["processing_purpose_id", "withdrawal_recognized_at", "withdrawal_recognized_sequence"],
            "properties": {
              "processing_purpose_id": { "$ref": "common.schema.json#/$defs/processingPurposeId" },
              "withdrawal_recognized_at": { "$ref": "common.schema.json#/$defs/dateTime" },
              "withdrawal_recognized_sequence": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "alternative_legal_bases": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["alternative_legal_basis_id", "processing_purpose_id", "legal_basis", "policy_version", "effective_at"],
            "properties": {
              "alternative_legal_basis_id": { "$ref": "common.schema.json#/$defs/id" },
              "processing_purpose_id": { "$ref": "common.schema.json#/$defs/processingPurposeId" },
              "legal_basis": { "type": "string", "minLength": 1 },
              "policy_version": { "type": "string", "minLength": 1 },
              "effective_at": { "$ref": "common.schema.json#/$defs/dateTime" }
            }
          }
        },
        "timestamp_stale_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["before", "authority", "policy_version", "policy_digest"],
          "properties": {
            "before": { "$ref": "common.schema.json#/$defs/dateTime" },
            "authority": { "const": "server" },
            "policy_version": { "type": "string", "minLength": 1 },
            "policy_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          }
        },
        "click_injection_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["threshold_seconds", "authority", "policy_version", "policy_digest"],
          "properties": {
            "threshold_seconds": { "type": "number", "exclusiveMinimum": 0, "default": 10 },
            "authority": { "const": "server" },
            "policy_version": { "type": "string", "minLength": 1 },
            "policy_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          }
        },
        "fraud_enabled": { "type": "boolean", "default": true },
        "fraud_rule_bundle": { "$ref": "#/$defs/fraudRuleBundleContext" },
        "fraud_actions_enabled": { "type": "boolean", "default": false }
      }
    },
    "fraudRuleBundleContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_bundle_revision_id", "rule_bundle_id", "rule_bundle_version",
        "rule_bundle_hash", "definition_digest", "definition"
      ],
      "properties": {
        "rule_bundle_revision_id": { "$ref": "common.schema.json#/$defs/id" },
        "rule_bundle_id": { "$ref": "common.schema.json#/$defs/id" },
        "rule_bundle_version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "rule_bundle_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "definition_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "definition": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "version", "layers", "rules"],
          "properties": {
            "id": { "$ref": "common.schema.json#/$defs/id" },
            "version": { "type": "string", "minLength": 1, "maxLength": 128 },
            "layers": {
              "type": "object",
              "additionalProperties": false,
              "required": ["base"],
              "properties": {
                "base": { "type": "object", "additionalProperties": { "anyOf": [{ "type": "string" }, { "type": "number" }, { "type": "boolean" }] } },
                "operator": { "type": "object", "additionalProperties": { "anyOf": [{ "type": "string" }, { "type": "number" }, { "type": "boolean" }] } },
                "private": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["digest"],
                  "properties": { "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
                }
              }
            },
            "rules": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "inputs", "action"],
                "properties": {
                  "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,127}$" },
                  "inputs": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
                  "action": { "enum": ["allow", "flag", "exclude", "quarantine"] }
                }
              }
            }
          }
        }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version", "record_id", "delivery_id", "tenant_id", "app_id", "producer",
        "producer_version", "event_id", "event_name", "schema_version", "occurred_at",
        "occurred_at_source", "received_at", "payload", "processing_sequence"
      ],
      "properties": {
        "contract_version": { "const": "0.4.0" },
        "record_id": { "$ref": "common.schema.json#/$defs/id" },
        "delivery_id": { "$ref": "common.schema.json#/$defs/id" },
        "tenant_id": { "$ref": "common.schema.json#/$defs/id" },
        "app_id": { "$ref": "common.schema.json#/$defs/id" },
        "producer": { "type": "string", "pattern": "^(sdk-android|sdk-ios|redirector|import:[a-z0-9-]+|adapter:[a-z0-9-]+|postback:[a-z0-9-]+)$" },
        "producer_version": { "type": "string", "minLength": 1 },
        "producer_variant": { "type": "string", "minLength": 1, "maxLength": 64 },
        "wrapper_version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "event_id": { "$ref": "common.schema.json#/$defs/id" },
        "event_name": { "enum": ["click", "install", "session_start", "ad_impression", "ad_view", "ad_revenue", "purchase", "refund", "consent_changed", "custom_event", "skan_postback", "adattributionkit_postback", "deep_link_open"] },
        "schema_version": { "const": "0.4.0" },
        "occurred_at": { "$ref": "#/$defs/ingressDateTimeSyntax" },
        "occurred_at_source": { "enum": ["device", "server", "import"] },
        "received_at": { "$ref": "common.schema.json#/$defs/dateTime" },
        "payload": {
          "type": "object",
          "additionalProperties": true,
          "$comment": "Closed by event_name dispatch to the matching event schema."
        },
        "late": { "type": "boolean" },
        "subject_scope": { "enum": ["installation_level", "aggregate"] },
        "processing_purpose_id": { "$ref": "common.schema.json#/$defs/processingPurposeId" },
        "processing_sequence": { "type": "integer", "minimum": 0 },
        "integrity_verdict": { "$ref": "common.schema.json#/$defs/integrityVerdict" },
        "alternative_legal_basis_id": { "$ref": "common.schema.json#/$defs/id" }
      }
    },
    "ingressDateTimeSyntax": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "retentionExpiration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tenant_id", "app_id", "record_id", "expired_at", "policy_version", "lifecycle_status"],
      "properties": {
        "tenant_id": { "$ref": "common.schema.json#/$defs/id" },
        "app_id": { "$ref": "common.schema.json#/$defs/id" },
        "record_id": { "$ref": "common.schema.json#/$defs/id" },
        "expired_at": { "$ref": "common.schema.json#/$defs/dateTime" },
        "policy_version": { "type": "string", "minLength": 1 },
        "lifecycle_status": { "const": "purged" }
      }
    },
    "preIngestionRejection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "delivery_id", "record_id", "tenant_id", "app_id", "received_at",
        "reason_code", "consent_evaluation_policy_version", "consent_decision_reason_code"
      ],
      "properties": {
        "delivery_id": { "$ref": "common.schema.json#/$defs/id" },
        "record_id": { "$ref": "common.schema.json#/$defs/id" },
        "tenant_id": { "$ref": "common.schema.json#/$defs/id" },
        "app_id": { "$ref": "common.schema.json#/$defs/id" },
        "received_at": { "$ref": "common.schema.json#/$defs/dateTime" },
        "reason_code": { "const": "payload_schema_invalid" },
        "processing_purpose_id": { "$ref": "common.schema.json#/$defs/processingPurposeId" },
        "consent_evaluation_policy_version": { "type": "string", "minLength": 1 },
        "consent_decision_reason_code": { "enum": ["consent_not_required", "consent_valid_before_withdrawal", "documented_alternative_legal_basis", "consent_withdrawn"] }
      }
    },
    "matchingKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "value", "scope", "normalization", "cardinality", "protected"],
      "properties": {
        "type": { "enum": ["external_row_id", "provider_install_id", "provider_click_id", "tracking_link_id", "campaign_id", "transaction_id", "impression_id", "tenant_app_composite"] },
        "value": { "type": "string" },
        "scope": { "enum": ["tenant", "tenant_app"] },
        "normalization": { "enum": ["identity", "lowercase_ascii", "trim"] },
        "cardinality": { "enum": ["one_to_one", "one_to_many"] },
        "protected": { "type": "boolean" },
        "value_encoding": { "enum": ["plain", "sha256"] },
        "access_class": { "enum": ["public", "protected", "private"] }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "enum": ["provider_install_id", "provider_click_id"] } }, "required": ["type"] },
          "then": {
            "required": ["value_encoding", "access_class"],
            "properties": {
              "value": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "protected": { "const": true },
              "value_encoding": { "const": "sha256" },
              "access_class": { "const": "protected" }
            }
          }
        }
      ]
    },
    "reconciliationInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reconciliation_id", "tenant_id", "app_id", "input_snapshot_id", "external_snapshot_id", "matching_keys", "candidates", "freshness"],
      "properties": {
        "reconciliation_id": { "$ref": "common.schema.json#/$defs/id" },
        "tenant_id": { "$ref": "common.schema.json#/$defs/id" },
        "app_id": { "$ref": "common.schema.json#/$defs/id" },
        "input_snapshot_id": { "$ref": "common.schema.json#/$defs/id" },
        "external_snapshot_id": { "$ref": "common.schema.json#/$defs/id" },
        "matching_keys": { "type": "array", "items": { "$ref": "#/$defs/matchingKey" } },
        "candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["candidate_id", "tenant_id", "app_id", "matching_keys", "window_status", "freshness", "excluded"],
            "properties": {
              "candidate_id": { "$ref": "common.schema.json#/$defs/id" },
              "tenant_id": { "$ref": "common.schema.json#/$defs/id" },
              "app_id": { "$ref": "common.schema.json#/$defs/id" },
              "matching_keys": { "type": "array", "items": { "$ref": "#/$defs/matchingKey" } },
              "window_status": { "enum": ["in_window", "out_of_window", "not_applicable"] },
              "freshness": { "enum": ["current", "stale", "recalculated"] },
              "excluded": { "type": "boolean" },
              "exclusion_reason": { "type": "string" }
            }
          }
        },
        "freshness": { "enum": ["current", "stale", "recalculated"] },
        "privacy_effect": { "enum": ["none", "redaction"] }
      }
    },
    "advertisingIdentifierFreeValue": {
      "oneOf": [
        {
          "type": "object",
          "propertyNames": {
            "not": {
              "pattern": "^(advertising_id|advertising_identifier|google_advertising_id|android_advertising_id|advertising_tracking_id|gaid|aaid|idfa|rdid)$"
            }
          },
          "additionalProperties": { "$ref": "#/$defs/advertisingIdentifierFreeValue" }
        },
        {
          "type": "array",
          "items": { "$ref": "#/$defs/advertisingIdentifierFreeValue" }
        },
        { "type": "string" },
        { "type": "number" },
        { "type": "boolean" },
        { "type": "null" }
      ]
    },
    "fxPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_version", "target_currency", "target_scale", "rounding_mode", "rates"],
      "properties": {
        "policy_version": { "type": "string", "minLength": 1 },
        "target_currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "target_scale": { "type": "integer", "minimum": 0, "maximum": 18 },
        "rounding_mode": { "const": "half_even" },
        "rates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["currency", "rate_unscaled", "rate_scale", "source", "as_of"],
            "properties": {
              "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
              "rate_unscaled": { "type": "string", "pattern": "^[0-9]+$" },
              "rate_scale": { "type": "integer", "minimum": 0, "maximum": 18 },
              "source": { "type": "string", "minLength": 1 },
              "as_of": { "$ref": "common.schema.json#/$defs/dateTime" }
            }
          }
        }
      }
    }
  }
}
