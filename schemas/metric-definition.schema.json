    },
    {
      "if": { "properties": { "metric_name": { "enum": ["cohort_total_net_revenue_d30_usd", "d30_total_net_roas", "cohort_total_net_ltv_d30_usd"] } }, "required": ["metric_name"] },
      "then": { "properties": { "definition": { "type": "object", "additionalProperties": true, "properties": { "numerator": { "const": "total_net_revenue" }, "window": { "type": "object", "additionalProperties": true, "properties": { "day": { "const": 30 } } } } } } }
    },
    {
      "if": { "properties": { "metric_name": { "enum": ["cohort_total_net_revenue_d90_usd", "d90_total_net_roas", "cohort_total_net_ltv_d90_usd"] } }, "required": ["metric_name"] },
      "then": { "properties": { "definition": { "type": "object", "additionalProperties": true, "properties": { "numerator": { "const": "total_net_revenue" }, "window": { "type": "object", "additionalProperties": true, "properties": { "day": { "const": 90 } } } } } } }
    },
    {
      "if": { "properties": { "value_type": { "const": "money" } }, "required": ["value_type"] },
      "then": { "properties": { "currency": {}, "amount_scale": {} }, "required": ["currency", "amount_scale"] },
      "else": {
        "not": {
          "anyOf": [
