              "rule_bundle_version": { "const": "0.4.8" },
              "rule_bundle_hash": { "const": "01b66078d11af8ace103a5d2cf594ffe79c19bd59a4dc1f20757339a8a7f4f5f" }
            }
          },
          {
            "properties": {
              "metric_definition_version": { "const": "0.4.9" },
              "rule_bundle_id": { "const": "metric-purchase-net" },
              "metric_name": { "enum": ["cohort_purchase_net_revenue_d30_usd", "cohort_purchase_net_revenue_d90_usd"] },
              "rule_bundle_version": { "const": "0.4.9" },
              "rule_bundle_hash": { "const": "709f6688c7bb8537b7af3aa3b5a3aa879036a866fe13a21b83244baec6389712" }
            }
          }
        ]
      }
    },
    {
      "if": { "properties": { "metric_name": { "const": "cohort_purchase_net_revenue_d0_usd" } }, "required": ["metric_name"] },
      "then": { "properties": { "definition": { "type": "object", "additionalProperties": true, "properties": { "numerator": { "const": "purchase_net_revenue" }, "window": { "type": "object", "additionalProperties": true, "properties": { "day": { "const": 0 } } } } } } }
    },
    {
      "if": { "properties": { "metric_name": { "const": "cohort_purchase_net_revenue_d1_usd" } }, "required": ["metric_name"] },
      "then": { "properties": { "definition": { "type": "object", "additionalProperties": true, "properties": { "numerator": { "const": "purchase_net_revenue" }, "window": { "type": "object", "additionalProperties": true, "properties": { "day": { "const": 1 } } } } } } }
    },
    {
      "if": { "properties": { "metric_name": { "const": "cohort_purchase_net_revenue_d3_usd" } }, "required": ["metric_name"] },
      "then": { "properties": { "definition": { "type": "object", "additionalProperties": true, "properties": { "numerator": { "const": "purchase_net_revenue" }, "window": { "type": "object", "additionalProperties": true, "properties": { "day": { "const": 3 } } } } } } }
    },
    {
      "if": { "properties": { "metric_name": { "const": "cohort_purchase_net_revenue_d7_usd" } }, "required": ["metric_name"] },
      "then": { "properties": { "definition": { "type": "object", "additionalProperties": true, "properties": { "numerator": { "const": "purchase_net_revenue" }, "window": { "type": "object", "additionalProperties": true, "properties": { "day": { "const": 7 } } } } } } }
    },
    {
      "if": { "properties": { "metric_name": { "const": "cohort_purchase_net_revenue_d30_usd" } }, "required": ["metric_name"] },
      "then": { "properties": { "definition": { "type": "object", "additionalProperties": true, "properties": { "numerator": { "const": "purchase_net_revenue" }, "window": { "type": "object", "additionalProperties": true, "properties": { "day": { "const": 30 } } } } } } }
    },
    {
      "if": { "properties": { "metric_name": { "const": "cohort_purchase_net_revenue_d90_usd" } }, "required": ["metric_name"] },
      "then": { "properties": { "definition": { "type": "object", "additionalProperties": true, "properties": { "numerator": { "const": "purchase_net_revenue" }, "window": { "type": "object", "additionalProperties": true, "properties": { "day": { "const": 90 } } } } } } }
    },
    {
      "if": {
        "properties": {
          "definition": { "type": "object", "additionalProperties": true, "properties": { "numerator": { "const": "total_net_revenue" } }, "required": ["numerator"] }
        },
        "required": ["definition"]
      },
      "then": {
        "properties": {
