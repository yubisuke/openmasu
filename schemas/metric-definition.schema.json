{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openmasu:schema:metric-definition:v0.4",
  "title": "OpenMasu Metric Definition v0.4",
  "type": "object",
  "additionalProperties": false,
  "required": ["metric_name", "metric_definition_version", "anchor_event", "aggregation_time_zone", "value_type", "definition", "rule_bundle_id", "rule_bundle_version", "rule_bundle_hash"],
  "properties": {
    "metric_name": { "type": "string", "pattern": "^[a-z][a-z0-9_]{2,127}$" },
    "metric_definition_version": { "type": "string", "minLength": 1, "maxLength": 64 },
    "anchor_event": { "enum": ["install", "calendar_day"] },
    "aggregation_time_zone": { "$ref": "common.schema.json#/$defs/aggregationTimeZone" },
    "value_type": { "enum": ["money", "ratio", "count"] },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "amount_scale": { "type": "integer", "minimum": 0, "maximum": 18 },
    "ratio_scale": { "type": "integer", "minimum": 0, "maximum": 18 },
    "definition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["calculation", "window", "numerator"],
      "properties": {
        "calculation": { "enum": ["revenue_sum", "revenue_over_cost", "active_installations_over_cohort", "revenue_over_cohort", "cohort_size", "event_count", "converted_installations", "converted_installations_over_cohort"] },
        "window": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "day"],
          "properties": {
            "type": { "enum": ["elapsed", "calendar_day", "activity_day"] },
            "day": { "type": "integer", "minimum": 0, "maximum": 3650 }
          }
        },
        "numerator": { "enum": ["revenue", "purchase_net_revenue", "total_net_revenue", "active_installations", "cohort_size", "events", "converted_installations"] },
        "denominator": { "enum": ["cost", "cohort_size"] },
        "cost_basis": { "const": "cohort_acquisition_day_current_snapshot" }
      }
    },
    "activity_events": { "type": "array", "minItems": 1, "uniqueItems": true, "default": ["session_start"], "items": { "type": "string", "minLength": 1 } },
    "event_names": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["click", "install", "skan_postback", "adattributionkit_postback", "deep_link_open"] }
    },
    "grouping_dimensions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["campaign_id", "network", "country", "cohort_date", "metric_date", "attribution_status", "apple_conversion_bucket"] }
    },
    "fraud_policy": { "enum": ["gross", "net"], "default": "gross" },
    "acquisition_basis": { "const": "selected_first_party_click" },
    "conversion_event_key": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
    "cost_selection_policy": { "const": "reject_overlapping_grains" },
    "rule_bundle_id": { "$ref": "common.schema.json#/$defs/id" },
    "rule_bundle_version": { "type": "string" },
    "rule_bundle_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "allOf": [
    {
      "if": { "anyOf": [
        { "properties": { "conversion_event_key": {} }, "required": ["conversion_event_key"] },
        { "properties": { "rule_bundle_id": { "const": "metric-custom-conversion" } }, "required": ["rule_bundle_id"] },
        { "properties": { "definition": { "type": "object", "additionalProperties": true,
          "anyOf": [
            { "properties": { "calculation": { "enum": ["converted_installations", "converted_installations_over_cohort"] } }, "required": ["calculation"] },
            { "properties": { "numerator": { "const": "converted_installations" } }, "required": ["numerator"] }
          ] } }, "required": ["definition"] }
      ] },
      "then": {
        "required": ["conversion_event_key", "acquisition_basis", "grouping_dimensions"],
        "properties": {
          "conversion_event_key": {}, "acquisition_basis": { "const": "selected_first_party_click" },
          "grouping_dimensions": { "type": "array", "items": { "enum": ["campaign_id", "network", "country", "cohort_date", "attribution_status"] } },
          "anchor_event": { "const": "install" }, "aggregation_time_zone": { "const": "UTC" },
          "metric_definition_version": { "const": "0.4.14" },
          "rule_bundle_id": { "const": "metric-custom-conversion" }, "rule_bundle_version": { "const": "0.4.14" },
          "rule_bundle_hash": { "const": "fb2a468a0d09624ab3cb0bfef07d83b7e8fc62dd036756dbef1a095cda2223ab" },
          "definition": { "type": "object", "additionalProperties": true,
            "properties": { "calculation": { "enum": ["converted_installations", "converted_installations_over_cohort"] },
              "numerator": { "const": "converted_installations" },
              "window": { "type": "object", "additionalProperties": true, "properties": { "type": { "const": "elapsed" }, "day": { "const": 7 } } }
            }, "not": { "properties": { "cost_basis": {} }, "required": ["cost_basis"] } }
        },
        "not": { "anyOf": [
          { "properties": { "activity_events": {} }, "required": ["activity_events"] },
          { "properties": { "event_names": {} }, "required": ["event_names"] },
          { "properties": { "cost_selection_policy": {} }, "required": ["cost_selection_policy"] }
        ] },
        "if": { "properties": { "definition": { "type": "object", "additionalProperties": true,
          "properties": { "calculation": { "const": "converted_installations" } }, "required": ["calculation"] } }, "required": ["definition"] },
        "then": { "properties": { "value_type": { "const": "count" },
          "definition": { "type": "object", "additionalProperties": true, "not": { "properties": { "denominator": {} }, "required": ["denominator"] } } },
          "not": { "properties": { "ratio_scale": {} }, "required": ["ratio_scale"] } },
        "else": { "properties": { "value_type": { "const": "ratio" }, "ratio_scale": { "const": 6 },
          "definition": { "type": "object", "additionalProperties": true, "properties": { "denominator": { "const": "cohort_size" } }, "required": ["denominator"] } } }
      }
    },
    {
      "if": { "properties": { "rule_bundle_id": { "const": "metric-selected-commerce" } }, "required": ["rule_bundle_id"] },
      "then": {
        "required": ["acquisition_basis"],
        "properties": {
          "acquisition_basis": { "const": "selected_first_party_click" },
          "anchor_event": { "const": "install" }, "aggregation_time_zone": { "const": "UTC" },
          "metric_definition_version": { "const": "0.4.13" }, "rule_bundle_version": { "const": "0.4.13" },
          "rule_bundle_hash": { "const": "49554ad7fe9709e851f5cba7ac12215b539a9b209cc96ab66a085f0b1b46615d" },
          "definition": { "type": "object", "additionalProperties": true,
            "properties": { "numerator": { "enum": ["purchase_net_revenue", "total_net_revenue"] } } }
        },
        "if": { "properties": { "definition": { "type": "object", "additionalProperties": true,
          "properties": { "calculation": { "const": "revenue_over_cost" } }, "required": ["calculation"] } }, "required": ["definition"] },
        "then": { "properties": { "cost_selection_policy": {} }, "required": ["cost_selection_policy"] },
        "else": { "not": { "properties": { "cost_selection_policy": {} }, "required": ["cost_selection_policy"] } }
      }
    },
    {
      "if": { "properties": { "rule_bundle_id": { "const": "metric-disjoint-cost" } }, "required": ["rule_bundle_id"] },
      "then": { "properties": { "cost_selection_policy": {} }, "required": ["cost_selection_policy"] }
    },
    {
      "if": { "properties": { "cost_selection_policy": {}, "rule_bundle_id": { "not": { "const": "metric-selected-commerce" } } }, "required": ["cost_selection_policy", "rule_bundle_id"] },
      "then": {
        "properties": {
          "anchor_event": { "const": "install" }, "aggregation_time_zone": { "const": "UTC" },
          "metric_definition_version": { "const": "0.4.12" },
          "rule_bundle_id": { "const": "metric-disjoint-cost" },
          "rule_bundle_version": { "const": "0.4.12" },
          "rule_bundle_hash": { "const": "3ec3e50fc8b9180b55e888895d793739028fdd20abfc34f20110e6ce96e8b053" },
          "definition": {
            "type": "object", "additionalProperties": true,
            "properties": { "calculation": { "const": "revenue_over_cost" },
              "window": { "type": "object", "additionalProperties": true, "properties": { "type": { "const": "elapsed" } } } }
          }
        },
        "allOf": [
          {
            "if": { "properties": { "acquisition_basis": {} }, "required": ["acquisition_basis"] },
            "then": { "properties": { "definition": { "type": "object", "additionalProperties": true,
              "properties": { "numerator": { "const": "revenue" } } } } }
          }
        ]
      }
    },
    {
      "if": { "properties": { "acquisition_basis": {}, "cost_selection_policy": {}, "rule_bundle_id": { "not": { "enum": ["metric-selected-commerce", "metric-custom-conversion"] } } }, "required": ["acquisition_basis", "rule_bundle_id"], "not": { "required": ["cost_selection_policy"] } },
      "then": {
        "properties": {
          "anchor_event": { "const": "install" },
          "metric_definition_version": { "const": "0.4.11" },
          "rule_bundle_id": { "const": "metric-selected-acquisition" },
          "rule_bundle_version": { "const": "0.4.11" },
          "rule_bundle_hash": { "const": "6fd998246bb092f81d8539b8e2c04a1abe421a1916480b63dfd018d11c7bccc5" },
          "definition": {
            "type": "object", "additionalProperties": true,
            "properties": { "numerator": { "enum": ["revenue", "active_installations", "cohort_size"] } }
          }
        }
      }
    },
    {
      "if": { "properties": { "rule_bundle_id": { "const": "metric-selected-acquisition" } }, "required": ["rule_bundle_id"] },
      "then": { "properties": { "acquisition_basis": {} }, "required": ["acquisition_basis"] }
    },
    {
      "if": {
        "properties": {
          "definition": {
            "type": "object",
            "additionalProperties": true,
            "properties": { "numerator": { "const": "purchase_net_revenue" } },
