# Non-secret template only. Copy outside the public repository and set your origins.
# Supply this file explicitly to EVERY Compose command; keep a stable project name.
OPENMASU_PUBLIC_BASE_URL=https://metrics.example.invalid
OPENMASU_REDIRECTOR_BASE_URL=https://links.example.invalid
OPENMASU_REDIRECTOR_DESTINATION_ALLOWLIST=https://app.example.invalid
OPENMASU_MAX_TENANT_ID=tenant-example
OPENMASU_MAX_APP_ID=app-example
OPENMASU_POSTGRES_HOST_PORT=5432
OPENMASU_API_HOST_PORT=8080
OPENMASU_REDIRECTOR_HOST_PORT=8090
# Optional providers/exports stay disabled until separately authorized/configured.
OPENMASU_COST_REFRESH_ENABLED=off
OPENMASU_COMMERCE_READBACKS=off
OPENMASU_APPLE_STORE_NOTIFICATIONS=off
OPENMASU_GOOGLE_DATA_MANAGER_ENABLED=off
OPENMASU_OPERATOR_WEBHOOKS_ENABLED=off
OPENMASU_OPERATOR_BULK_EXPORTS_ENABLED=off
