{
  "version": "1.0.0",
  "kind": "manual_cost",
  "source_id": "synthetic-decimal-cost",
  "tenant_id": "tenant-local",
  "app_id": "app-local",
  "format": "csv",
  "rules": [
    { "target": "network", "expression": { "source": "network" } },
    { "target": "campaign_id", "expression": { "source": "campaign_id" } },
    { "target": "country", "expression": { "source": "country", "uppercase": true } },
    { "target": "date", "expression": { "source": "date" } },
    { "target": "as_of", "expression": { "source": "as_of", "timestamp": { "default_timezone": "UTC", "truncate_to_milliseconds": true } } },
    { "target": "money", "expression": { "source": "cost_decimal", "money": { "input": "decimal", "scale": 6, "currency_source": "currency" } } }
  ]
}
