{
  "version": "1.0.0",
  "kind": "mmp_raw",
  "source_id": "synthetic-provider-clicks",
  "tenant_id": "tenant-local",
  "app_id": "app-local",
  "provider": "synthetic-provider",
  "format": "json",
  "row_filter": { "source": "event_type", "equals": "click" },
  "rules": [
    { "target": "event_name", "expression": { "const": "click" } },
    { "target": "event_id", "expression": { "source": "event_id" } },
    { "target": "occurred_at", "expression": { "source": "occurred_at", "timestamp": { "default_timezone": "UTC", "truncate_to_milliseconds": true } } },
    {
      "target": "payload",
      "expression": {
        "object": {
          "click_id": { "source": "click_id" },
          "tracking_link_id": { "source": "tracking_link_id" },
          "campaign_id": { "source": "campaign_id" },
          "redirector_time_status": { "const": "missing" },
          "bot_prefetch": { "source": "prefetch", "boolean": { "true_values": ["yes", 1, true], "false_values": ["no", 0, false], "default": false } },
          "country": { "source": "country", "uppercase": true },
          "import_context": {
            "object": {
              "provider": { "const": "synthetic-provider" },
              "provider_attributed": { "source": "attributed", "boolean": { "true_values": ["paid", true], "false_values": ["organic", false] } },
              "provider_attribution_strategy": { "source": "strategy", "map": { "click": "click_through", "view": "view_through" }, "map_default": "unknown" },
              "provider_click_ref": { "source": "provider_click_ref" },
              "provider_campaign_ref": { "source": "campaign_id" },
              "provider_country": { "source": "country", "uppercase": true },
              "provider_confirmed_at": { "source": "confirmed_at", "timestamp": { "default_timezone": "UTC", "truncate_to_milliseconds": true } }
            }
          }
        }
      }
    }
  ]
}
