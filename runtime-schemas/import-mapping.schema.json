{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:open-mmp:runtime-schema:import-mapping:v1",
  "title": "Open MMP runtime import mapping",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "kind", "source_id", "tenant_id", "app_id", "format", "rules"],
  "properties": {
    "version": { "const": "1.0.0" },
    "kind": { "enum": ["mmp_raw", "manual_cost"] },
    "source_id": { "$ref": "#/$defs/id" },
    "tenant_id": { "$ref": "#/$defs/id" },
    "app_id": { "$ref": "#/$defs/id" },
    "provider": { "type": "string", "pattern": "^[a-z0-9-]{1,64}$" },
    "format": { "enum": ["csv", "json", "jsonl"] },
    "row_filter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "equals"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "equals": { "type": ["string", "number", "boolean"] }
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target", "expression"],
        "properties": {
          "target": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
          },
          "expression": { "$ref": "#/$defs/expression" }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$" },
    "expression": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "const": {},
        "default": {},
        "map": {
          "type": "object",
          "additionalProperties": { "type": ["string", "number", "boolean", "null"] }
        },
        "map_default": { "type": ["string", "number", "boolean", "null"] },
        "boolean": {
          "type": "object",
          "additionalProperties": false,
          "required": ["true_values", "false_values"],
          "properties": {
            "true_values": { "type": "array", "items": { "type": ["string", "number", "boolean"] } },
            "false_values": { "type": "array", "items": { "type": ["string", "number", "boolean"] } },
            "default": { "type": "boolean" }
          }
        },
        "uppercase": { "type": "boolean" },
        "timestamp": {
          "type": "object",
          "additionalProperties": false,
          "required": ["default_timezone", "truncate_to_milliseconds"],
          "properties": {
            "default_timezone": { "enum": ["UTC"] },
            "timezone_source": { "type": "string", "minLength": 1 },
            "truncate_to_milliseconds": { "const": true }
          }
        },
        "money": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scale"],
          "properties": {
            "scale": { "type": "integer", "minimum": 0, "maximum": 18 },
            "currency_source": { "type": "string", "minLength": 1 },
            "currency_default": { "type": "string", "pattern": "^[A-Z]{3}$" }
          }
        },
        "object": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/expression" }
        }
      },
      "anyOf": [
        { "properties": { "source": {} }, "required": ["source"] },
        { "properties": { "const": {} }, "required": ["const"] },
        { "properties": { "object": {} }, "required": ["object"] }
      ]
    }
  }
}
